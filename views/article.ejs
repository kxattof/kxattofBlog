<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= pageTitle %></title>
    <link rel="icon" type="image/x-icon" href="/Assets/Kxattof_Filled.png" />
    <link rel="stylesheet" href="/style.css" />
    <link rel="stylesheet" href="/article.css" />
  </head>
  <body>
    <div class="content">
      <header>
        <h1 class="hepta"><a href="/">Kxattof</a></h1>
        <p class="montserrat">Article ID #<%= articleId %></p>
      </header>
      <div class="menuBar">
          <%- menuBar %>
      </div>
      <div id="article-content" class="article_content">
        <h1 class="articleTitle"><%= articleTitle %></h1>
        <br />
        <div class="authorContainer">
          <img src="/Assets/Profile_Picture2.png" class="pfpPicture">
          <a class="author" href="/author/<%- author %>"><%- author %></a>
        </div>
        <%- articleContent %>
      </div>
      <div class="articleFooterContainer">
        <div class="dates">
          <span class="published">Published: <%- published %></span>
          <span class="edited">Last Edited: <%- edited %></span>
        </div>
        <div class="dates">
          <span class="published">Written By: <%- author %></span>
        </div>
        <span class="articleFooter"
          >This article is protected by our
          <a href="/licenses">Content License</a>.</span
        >
      </div>
    </div>
  </body>
</html>
