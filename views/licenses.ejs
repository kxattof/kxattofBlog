<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kxattof | Contact</title>
    <link rel="icon" type="image/x-icon" href="/Assets\Kxattof_Filled.png" />
    <link rel="stylesheet" href="/style.css" />
    <link rel="stylesheet" href="/licenses.css" />
  </head>
  <body>
    <div class="content">
      <header>
        <h1 class="hepta"><a href="/">Kxattof</a></h1>
        <p class="montserrat">Licenses</p>
      </header>
      <div class="menuBar">
          <%- menuBar %>
      </div>
      <div id="article-content" class="article_content">
        <h2>Licenses</h2>
        <p>The licenses for the website code and the content.</p>
        <div class="twoBoxContainer">
          <div class="twoBox">
            <h3>CODE LICENSE (Applies to website code only)</h3>
            <pre><%= codeLicense %></pre>
          </div>

          <div class="twoBox">
            <h3>CONTENT LICENSE (Applies to articles only)</h3>
            <pre><%= contentLicense %></pre>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
